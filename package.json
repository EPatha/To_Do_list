{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve": "php artisan serve",
        "serve:dev": "concurrently \"php artisan serve\" \"npm run dev\"",
        "install:full": "composer install && npm install",
        "setup": "cp .env.example .env && php artisan key:generate && touch database/database.sqlite && php artisan migrate",
        "fresh": "php artisan migrate:fresh"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4"
    }
}
