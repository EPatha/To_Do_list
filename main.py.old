#!/usr/bin/env python3
"""
Jarvis To-Do List AI - Main Entry Point
Voice-enabled AI assistant for local task management

Author: Ephesians Prismaranatha
Version: 1.0.0
"""

print("🔴 DEBUG: Starting main.py execution...")

import asyncio
import signal
import sys

print("🔴 DEBUG: Basic imports done...")

from modules.stt import SpeechToText
from modules.llm import LLMHandler
from modules.command_parser import CommandParser
from modules.todo_manager import TodoManager
from modules.tts import TextToSpeech
from config.settings import *

print("🔴 DEBUG: All imports completed...")

class JarvisAI:
    def __init__(self):
        print("🤖 Initializing Jarvis AI...")
        
        # Initialize components
        self.stt = SpeechToText()
        self.llm = LLMHandler()
        self.parser = CommandParser()
        self.todo_manager = TodoManager()
        self.tts = TextToSpeech()
        
        self.running = False
        print("✅ Jarvis AI initialized successfully!")

    async def start(self):
        """Start Jarvis AI main loop"""
        self.running = True
        
        # Welcome message
        welcome_msg = "Halo! Saya Jarvis, asisten AI Anda. Saya siap membantu mengelola task Anda!"
        print(f"🤖 Jarvis: {welcome_msg}")
        await self.tts.speak(welcome_msg)
        
        print("\n🎤 Listening for voice commands... (Press Ctrl+C to exit)")
        
        while self.running:
            try:
                # Listen for voice input
                print("\n🎤 Listening...")
                audio_text = await self.stt.listen()
                
                if audio_text:
                    print(f"👤 You: {audio_text}")
                    
                    # Process command with LLM
                    processed_command = await self.llm.process(audio_text)
                    
                    # Parse and execute command
                    result = await self.parser.parse_and_execute(
                        processed_command, self.todo_manager
                    )
                    
                    # Respond with voice
                    print(f"🤖 Jarvis: {result}")
                    await self.tts.speak(result)
                
                # Small delay to prevent excessive CPU usage
                await asyncio.sleep(0.1)
                
            except KeyboardInterrupt:
                break
            except Exception as e:
                error_msg = f"Maaf, terjadi kesalahan: {str(e)}"
                print(f"❌ Error: {error_msg}")
                await self.tts.speak(error_msg)

    def stop(self):
        """Stop Jarvis AI"""
        self.running = False
        print("\n👋 Jarvis AI shutdown complete. Goodbye!")

async def main():
    """Main function"""
    print("🚀 Starting Jarvis AI main function...")
    
    try:
        jarvis = JarvisAI()
        print("🤖 Jarvis instance created successfully")
        
        # Setup signal handlers for graceful shutdown
        def signal_handler(signum, frame):
            print("\n\n🛑 Shutdown signal received...")
            jarvis.stop()
            sys.exit(0)
        
        signal.signal(signal.SIGINT, signal_handler)
        signal.signal(signal.SIGTERM, signal_handler)
        
        print("📡 Signal handlers setup complete")
        print("🎤 Starting Jarvis AI...")
        
        await jarvis.start()
        
    except Exception as e:
        print(f"❌ Fatal error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)

if __name__ == "__main__":
    asyncio.run(main())
